include MANIFEST.in
include README.md setup.py LICENSE NOTICE

include ciderpress/data/*.npy
recursive-include ciderpress/data/functionals *.yaml

prune pyscf/lib/build

# Source distributions must be portable and must not capture locally built
# libraries.  The extension modules and their dependencies are rebuilt during
# installation.

# source code
recursive-include ciderpress/lib *.c *.h *.h.in CMakeLists.txt
recursive-exclude ciderpress/lib *.cl
prune ciderpress/lib/deps
recursive-exclude ciderpress/lib *.so* *.dylib*

global-exclude *.py[cod]
prune ciderpress/lib/build

# Documentation is built and deployed separately from the source package.
prune docs
